<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS AI - Pro Trading Assistant</title>
    <!-- TradingView Lightweight Charts SDK -->
    <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0b0e14;
            --card-bg: #151924;
            --card-border: #232838;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-yellow: #f59e0b;
            --text-main: #f3f4f6;
            --text-sub: #9ca3af;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            padding: 12px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .logo-box { display: flex; align-items: center; gap: 10px; }
        .logo-icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            font-weight: bold; font-size: 18px;
        }

        .logo-text { font-size: 20px; font-weight: 800; }
        .logo-text span { color: var(--accent-blue); }

        .badge-pro {
            background: rgba(139, 92, 246, 0.2); color: var(--accent-purple);
            border: 1px solid var(--accent-purple); font-size: 11px;
            padding: 2px 8px; border-radius: 12px; font-weight: 600;
        }

        .controls {
            display: flex; flex-wrap: wrap; gap: 10px;
            align-items: center; justify-content: space-between; margin-bottom: 12px;
        }

        select {
            background: var(--card-bg); color: var(--text-main);
            border: 1px solid var(--card-border); padding: 8px 14px;
            border-radius: 8px; font-size: 14px; outline: none;
            font-weight: 600;
        }

        .timeframe-group {
            display: flex; background: var(--card-bg);
            border: 1px solid var(--card-border); border-radius: 8px; overflow: hidden;
        }

        .tf-btn {
            background: transparent; border: none; color: var(--text-sub);
            padding: 6px 12px; font-size: 12px; font-weight: 700; cursor: pointer;
        }

        .tf-btn.active { background: var(--accent-blue); color: #fff; }

        .live-status {
            display: flex; align-items: center; gap: 6px;
            background: rgba(16, 185, 129, 0.15); color: var(--accent-green);
            padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600;
        }

        .live-dot {
            width: 8px; height: 8px; background: var(--accent-green);
            border-radius: 50%; animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.2); }
            100% { opacity: 1; transform: scale(1); }
        }

        .price-bar {
            display: flex; justify-content: space-between; align-items: center;
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: 12px; padding: 12px 16px; margin-bottom: 12px;
        }

        .price-display { font-size: 24px; font-weight: 700; color: var(--accent-green); }

        .analyze-btn {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            color: white; border: none; padding: 10px 18px; border-radius: 8px;
            font-weight: 700; font-size: 13px; cursor: pointer;
            display: flex; align-items: center; gap: 8px;
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
        }

        .recommendation-banner {
            padding: 12px; border-radius: 10px; text-align: center;
            font-weight: 800; font-size: 14px; margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .rec-pass {
            background: rgba(16, 185, 129, 0.15); border: 1.5px solid var(--accent-green); color: var(--accent-green);
        }

        .rec-avoid {
            background: rgba(239, 68, 68, 0.15); border: 1.5px solid var(--accent-red); color: var(--accent-red);
        }

        .chart-card {
            background: #151924; border: 1px solid var(--card-border);
            border-radius: 12px; padding: 8px; margin-bottom: 12px;
            position: relative;
        }

        #chart-container { width: 100%; height: 380px; background-color: #151924; }

        .percentage-panel {
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: 12px; padding: 14px; margin-bottom: 12px;
            display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.02); border: 1px solid var(--card-border);
            border-radius: 8px; padding: 12px; text-align: center;
        }

        .stat-title {
            font-size: 11px; color: var(--text-sub); font-weight: 600;
            margin-bottom: 4px; text-transform: uppercase;
        }

        .stat-val-win { font-size: 20px; font-weight: 800; color: var(--accent-green); }
        .stat-val-risk { font-size: 20px; font-weight: 800; color: var(--accent-blue); }

        .metrics-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 10px; margin-bottom: 12px;
        }

        .metric-card {
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: 10px; padding: 12px;
        }

        .metric-title { font-size: 11px; color: var(--text-sub); font-weight: 600; margin-bottom: 4px; }
        .metric-value { font-size: 17px; font-weight: 700; }
        .metric-sub { font-size: 10px; color: var(--text-sub); margin-top: 2px; }

        .val-entry { color: var(--accent-blue); }
        .val-sl { color: var(--accent-red); }
        .val-tp { color: var(--accent-green); }

        .ai-section {
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: 12px; padding: 16px; display: flex;
            align-items: center; justify-content: space-between;
            margin-bottom: 12px;
        }

        .prob-circle {
            width: 65px; height: 65px; border-radius: 50%;
            background: conic-gradient(var(--accent-green) 0%, var(--card-border) 0);
            display: flex; align-items: center; justify-content: center;
        }

        .prob-circle-inner {
            width: 50px; height: 50px; background: var(--card-bg);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 13px; color: var(--accent-green);
        }

        .news-ticker-card {
            background: var(--card-bg);
            border: 1px solid var(--accent-yellow);
            border-radius: 12px;
            padding: 14px;
        }
        .news-header {
            display: flex; align-items: center; gap: 8px;
            font-size: 12px; font-weight: 700; color: var(--accent-yellow);
            margin-bottom: 6px; text-transform: uppercase;
        }
        .news-content {
            font-size: 13px; color: var(--text-main); line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-box">
            <div class="logo-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div class="logo-text">NEXUS<span>AI</span></div>
            <span class="badge-pro">PRO V2.5</span>
        </div>
        <div class="live-status">
            <div class="live-dot"></div>
            MARKET LIVE
        </div>
    </div>

    <div class="controls">
        <select id="symbolSelect" onchange="changeSymbol(this.value)">
            <option value="PAXGUSDT">🟡 XAU/USD (Gold/USDT)</option>
            <option value="BTCUSDT">🪙 BTC/USDT (Bitcoin)</option>
            <option value="ETHUSDT">🔷 ETH/USDT (Ethereum)</option>
            <option value="SOLUSDT">🟣 SOL/USDT (Solana)</option>
            <option value="BNBUSDT">🟢 BNB/USDT (Binance Coin)</option>
        </select>
        <div class="timeframe-group">
            <button class="tf-btn" onclick="changeTimeframe('1m', this)">1M</button>
            <button class="tf-btn" onclick="changeTimeframe('5m', this)">5M</button>
            <button class="tf-btn active" onclick="changeTimeframe('15m', this)">15M</button>
            <button class="tf-btn" onclick="changeTimeframe('1h', this)">1H</button>
        </div>
    </div>

    <div class="price-bar">
        <div>
            <div id="livePrice" class="price-display">$0.00</div>
            <div style="font-size: 11px; color: var(--accent-green); font-weight: 600;">Live Binance Stream</div>
        </div>
        <button class="analyze-btn" onclick="runAiAnalysis()">
            <i class="fa-solid fa-bolt"></i> ANALYZE WITH AI
        </button>
    </div>

    <div class="recommendation-banner rec-pass" id="recBanner">
        <i class="fa-solid fa-shield-halved"></i> EMA 20/50 ACTIVE — READY FOR INDEPENDENT AI SCAN
    </div>

    <div class="chart-card">
        <div id="chart-container"></div>
    </div>

    <div class="percentage-panel">
        <div class="stat-box">
            <div class="stat-title"><i class="fa-solid fa-arrow-trend-up"></i> Live Win Probability</div>
            <div class="stat-val-win" id="winProbPercent">-- %</div>
            <div style="font-size: 10px; color: var(--text-sub); margin-top: 2px;" id="winStatusText">Awaiting AI Evaluation</div>
        </div>
        <div class="stat-box">
            <div class="stat-title"><i class="fa-solid fa-clock"></i> Live Trend Duration</div>
            <div class="stat-val-risk" id="durationText">--</div>
            <div style="font-size: 10px; color: var(--text-sub); margin-top: 2px;" id="trendDirText">Active Window</div>
        </div>
    </div>

    <div class="metrics-grid">
        <div class="metric-card" style="border-left: 3px solid var(--accent-blue);">
            <div class="metric-title">ENTRY PRICE</div>
            <div id="valEntry" class="metric-value val-entry">PENDING</div>
            <div class="metric-sub">Optimal Order</div>
        </div>
        <div class="metric-card" style="border-left: 3px solid var(--accent-red);">
            <div class="metric-title">STOP LOSS (SL)</div>
            <div id="valSL" class="metric-value val-sl">PENDING</div>
            <div class="metric-sub">Risk Management</div>
        </div>
        <div class="metric-card" style="border-left: 3px solid var(--accent-green);">
            <div class="metric-title">TAKE PROFIT 1 (Short)</div>
            <div id="valTP1" class="metric-value val-tp">PENDING</div>
            <div class="metric-sub">Target 1 (Quick Trade)</div>
        </div>
        <div class="metric-card" style="border-left: 3px solid var(--accent-green);">
            <div class="metric-title">TAKE PROFIT 2 (Long)</div>
            <div id="valTP2" class="metric-value val-tp">PENDING</div>
            <div class="metric-sub">Target 2 (Extended Hold)</div>
        </div>
    </div>

    <div class="ai-section">
        <div style="max-width: 65%;">
            <h4 style="font-size: 15px; margin-bottom: 4px;">Gemini Live Market AI Scan</h4>
            <p id="aiReason" style="font-size: 12px; color: var(--text-sub);">EMA 20/50 lines active. Click analyze for independent AI evaluation.</p>
        </div>
        <div class="prob-circle" id="probCircle">
            <div class="prob-circle-inner" id="probText">--</div>
        </div>
    </div>

    <div class="news-ticker-card">
        <div class="news-header">
            <i class="fa-solid fa-satellite-dish"></i> Live Market News & Flash Radar (AI Powered)
        </div>
        <div class="news-content" id="newsContentText">
            Click "ANALYZE WITH AI" above to scan live candles, EMA momentum, and read independent AI market insights.
        </div>
    </div>

    <script>
        const GEMINI_API_KEY = "AQ.Ab8RN6LQ0MfSf8pp1K0bYA0OIqA5s6ErLVwaMLtral3QXieHvQ";

        let chart, candlestickSeries, ema20Series, ema50Series, ws;
        let entryLine, slLine, tp1Line, tp2Line;
        let currentSymbol = 'PAXGUSDT';
        let currentTimeframe = '15m';
        let currentPrice = 0;
        let candlesData = [];

        function initChart() {
            const container = document.getElementById('chart-container');
            container.innerHTML = '';

            chart = LightweightCharts.createChart(container, {
                layout: { background: { type: 'solid', color: '#151924' }, textColor: '#9ca3af' },
                grid: { vertLines: { color: '#232838' }, horzLines: { color: '#232838' } },
                rightPriceScale: { borderColor: '#232838', autoScale: true },
                timeScale: { borderColor: '#232838', timeVisible: true },
            });

            candlestickSeries = chart.addCandlestickSeries({
                upColor: '#10b981', downColor: '#ef4444',
                borderDownColor: '#ef4444', borderUpColor: '#10b981',
                wickDownColor: '#ef4444', wickUpColor: '#10b981',
            });

            ema20Series = chart.addLineSeries({ color: '#f59e0b', lineWidth: 2, title: 'EMA 20' });
            ema50Series = chart.addLineSeries({ color: '#8b5cf6', lineWidth: 2, title: 'EMA 50' });

            loadHistoricalData(currentSymbol, currentTimeframe);
        }

        function calculateEMA(data, period) {
            let k = 2 / (period + 1);
            let emaData = [];
            let ema = data[0].close;

            for (let i = 0; i < data.length; i++) {
                ema = (data[i].close * k) + (ema * (1 - k));
                emaData.push({ time: data[i].time, value: ema });
            }
            return emaData;
        }

        async function loadHistoricalData(symbol, timeframe) {
            try {
                const res = await fetch(`https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=${timeframe}&limit=300`);
                const data = await res.json();
                
                candlesData = data.map(d => ({
                    time: d[0] / 1000,
                    open: parseFloat(d[1]),
                    high: parseFloat(d[2]),
                    low: parseFloat(d[3]),
                    close: parseFloat(d[4])
                }));

                candlestickSeries.setData(candlesData);
                ema20Series.setData(calculateEMA(candlesData, 20));
                ema50Series.setData(calculateEMA(candlesData, 50));

                if (candlesData.length > 0) {
                    currentPrice = candlesData[candlesData.length - 1].close;
                    document.getElementById('livePrice').innerText = `$${currentPrice.toFixed(2)}`;
                }

                connectBinanceWS(symbol, timeframe);
            } catch (e) {
                console.error("Binance error:", e);
            }
        }

        function connectBinanceWS(symbol, timeframe) {
            if (ws) ws.close();

            const sLower = symbol.toLowerCase();
            ws = new WebSocket(`wss://stream.binance.com:9443/ws/${sLower}@kline_${timeframe}`);

            ws.onmessage = (event) => {
                const data = JSON.parse(event.data);
                if (data.k) {
                    const candle = data.k;
                    currentPrice = parseFloat(candle.c);
                    document.getElementById('livePrice').innerText = `$${currentPrice.toFixed(2)}`;

                    const newCandle = {
                        time: candle.t / 1000,
                        open: parseFloat(candle.o),
                        high: parseFloat(candle.h),
                        low: parseFloat(candle.l),
                        close: currentPrice
                    };

                    candlestickSeries.update(newCandle);
                }
            };
        }

        function clearTradeLines() {
            if (entryLine) { candlestickSeries.removePriceLine(entryLine); entryLine = null; }
            if (slLine) { candlestickSeries.removePriceLine(slLine); slLine = null; }
            if (tp1Line) { candlestickSeries.removePriceLine(tp1Line); tp1Line = null; }
            if (tp2Line) { candlestickSeries.removePriceLine(tp2Line); tp2Line = null; }
            candlestickSeries.setMarkers([]);

            document.getElementById('valEntry').innerText = "PENDING";
            document.getElementById('valSL').innerText = "PENDING";
            document.getElementById('valTP1').innerText = "PENDING";
            document.getElementById('valTP2').innerText = "PENDING";
        }

        function updateTradeLinesOnChart(entry, sl, tp1, tp2) {
            clearTradeLines();

            document.getElementById('valEntry').innerText = `$${entry.toFixed(2)}`;
            document.getElementById('valSL').innerText = `$${sl.toFixed(2)}`;
            document.getElementById('valTP1').innerText = `$${tp1.toFixed(2)}`;
            document.getElementById('valTP2').innerText = `$${tp2.toFixed(2)}`;

            entryLine = candlestickSeries.createPriceLine({
                price: entry, color: '#3b82f6', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'AI Entry',
            });
            slLine = candlestickSeries.createPriceLine({
                price: sl, color: '#ef4444', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'Stop Loss',
            });
            tp1Line = candlestickSeries.createPriceLine({
                price: tp1, color: '#10b981', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'TP1 (Short Trade)',
            });
            tp2Line = candlestickSeries.createPriceLine({
                price: tp2, color: '#34d399', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'TP2 (Long Trade)',
            });
        }

        function changeSymbol(symbol) {
            currentSymbol = symbol;
            clearTradeLines();
            loadHistoricalData(symbol, currentTimeframe);
        }

        function changeTimeframe(tf, btn) {
            currentTimeframe = tf;
            document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            clearTradeLines();
            loadHistoricalData(currentSymbol, tf);
        }

        // FULLY INDEPENDENT AI SCANNER WITH ROBUST CORS / API ERROR HANDLING (ZERO MOCKS)
        async function runAiAnalysis() {
            const btn = document.querySelector('.analyze-btn');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> SCANNING LIVE AI...';
            
            document.getElementById('winProbPercent').innerText = "Analyzing...";
            document.getElementById('durationText').innerText = "Processing...";
            document.getElementById('newsContentText').innerText = "Connecting to Gemini AI and scanning live candles...";

            try {
                const last10 = candlesData.slice(-10).map(c => `O:${c.open}, H:${c.high}, L:${c.low}, C:${c.close}`).join("; ");
                
                const promptText = `Act as an expert quantitative trading bot. Analyze live candle data for ${currentSymbol} on ${currentTimeframe} timeframe with EMA 20 & 50 context. Current Price: ${currentPrice}. Recent candles: [${last10}]. 
Independently evaluate the market and determine the win probability (0 to 100) based on pure price action. 
Provide your independent assessment for "signal" ("BUY", "SELL", or "NONE"), "probability" (number), "duration", "trend", "reason", "news", and calculated levels ("entry", "sl", "tp1", "tp2").
Return ONLY valid raw JSON (no markdown/backticks) with format:
{"signal": "BUY"|"SELL"|"NONE", "probability": number, "duration": "string", "trend": "BULLISH"|"BEARISH"|"SIDEWAYS", "reason": "text", "news": "1 sentence market news", "entry": number|null, "sl": number|null, "tp1": number|null, "tp2": number|null}`;

                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ contents: [{ parts: [{ text: promptText }] }] })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                
                if (!data.candidates || !data.candidates[0].content) {
                    throw new Error("Invalid AI response structure");
                }

                let rawText = data.candidates[0].content.parts[0].text;
                rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();
                
                const aiData = JSON.parse(rawText);

                let winProb = aiData.probability || 50;
                let duration = aiData.duration || "N/A";
                let trend = aiData.trend || "SIDEWAYS";
                let signal = aiData.signal || "NONE";
                let marketNews = aiData.news || "Global markets operating under standard liquidity conditions.";

                document.getElementById('winProbPercent').innerText = `${winProb}%`;
                document.getElementById('durationText').innerText = duration;
                document.getElementById('trendDirText').innerText = `${trend} Trend`;
                document.getElementById('probText').innerText = `${winProb}%`;
                document.getElementById('aiReason').innerText = aiData.reason;
                document.getElementById('newsContentText').innerText = marketNews;

                const recBanner = document.getElementById('recBanner');

                if (signal !== "NONE" && aiData.entry && aiData.sl && aiData.tp1 && aiData.tp2) {
                    recBanner.className = "recommendation-banner rec-pass";
                    recBanner.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${trend} (${signal}) — WIN CHANCE: ${winProb}% (DURATION: ${duration})`;
                    document.getElementById('winStatusText').innerText = `AI Detected ${signal} Signal`;
                    document.getElementById('winStatusText').style.color = "#10b981";

                    updateTradeLinesOnChart(aiData.entry, aiData.sl, aiData.tp1, aiData.tp2);

                    if (candlesData.length > 0) {
                        const lastCandle = candlesData[candlesData.length - 1];
                        const isBuy = signal === "BUY";
                        candlestickSeries.setMarkers([{
                            time: lastCandle.time,
                            position: isBuy ? 'belowBar' : 'aboveBar',
                            color: isBuy ? '#10b981' : '#ef4444',
                            shape: isBuy ? 'arrowUp' : 'arrowDown',
                            text: `${signal} (${winProb}%)`,
                        }]);
                    }
                } else {
                    clearTradeLines();
                    recBanner.className = "recommendation-banner rec-avoid";
                    recBanner.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> NEUTRAL / NO CLEAR SETUP (${winProb}% WIN CHANCE)`;
                    document.getElementById('winStatusText').innerText = "Market Sideways / Wait";
                    document.getElementById('winStatusText').style.color = "#f59e0b";
                }

                document.getElementById('probCircle').style.background = `conic-gradient(#10b981 ${winProb}%, #232838 0)`;

            } catch (err) {
                console.error("Live AI Scan Error:", err);
                clearTradeLines();
                document.getElementById('winProbPercent').innerText = "Failed";
                document.getElementById('durationText').innerText = "Error";
                document.getElementById('trendDirText').innerText = "API Error";
                document.getElementById('aiReason').innerText = "Connection error or API block. Please check browser network/Brave shields.";
                document.getElementById('newsContentText').innerText = "⚠️ News radar offline: Connection restriction detected.";
                
                const recBanner = document.getElementById('recBanner');
                recBanner.className = "recommendation-banner rec-avoid";
                recBanner.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> AI SCAN FAILED — CHECK CONNECTION`;
            }

            btn.innerHTML = '<i class="fa-solid fa-bolt"></i> ANALYZE WITH AI';
        }

        window.onload = initChart;
    </script>
</body>
</html>
